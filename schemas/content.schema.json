{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/presentation-skill-lab/content.schema.json",
  "title": "Slide content contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deck_id",
    "metadata",
    "slides"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "deck_id": {
      "$ref": "#/$defs/id"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "audience",
        "objective",
        "language",
        "classification",
        "synthetic"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "const": "ja-JP"
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential"
          ]
        },
        "synthetic": {
          "type": "boolean"
        },
        "content_locked": {
          "type": "boolean"
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "data",
            "control",
            "dependency",
            "sync",
            "relationship"
          ]
        }
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "rows"
      ],
      "properties": {
        "headers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          }
        },
        "unit": {
          "type": "string"
        },
        "period": {
          "type": "string"
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "categories",
        "series",
        "unit"
      ],
      "properties": {
        "type": {
          "enum": [
            "bar",
            "line",
            "pie"
          ]
        },
        "unit": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "values"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "takeaway"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "cover",
            "section",
            "claim",
            "architecture",
            "flow",
            "er",
            "comparison",
            "table",
            "chart",
            "illustration",
            "appendix"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "takeaway": {
          "type": "string"
        },
        "body": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagram": {
          "$ref": "#/$defs/diagram"
        },
        "table": {
          "$ref": "#/$defs/table"
        },
        "chart": {
          "$ref": "#/$defs/chart"
        },
        "asset_ref": {
          "type": "string",
          "pattern": "^assets/[a-zA-Z0-9_./-]+$"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
