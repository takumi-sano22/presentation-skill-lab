{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/presentation-skill-lab/asset-manifest.schema.json",
  "title": "画像アセット manifest v0.1（<deck>/assets/manifest.yaml）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "media_type", "width", "height", "transparent", "alt", "contains_text", "origin", "license", "updated"],
        "properties": {
          "path": {"type": "string", "pattern": "^assets/[a-zA-Z0-9_./-]+\\.(svg|png|jpg|jpeg)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"enum": ["image/svg+xml", "image/png", "image/jpeg"]},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "transparent": {"type": "boolean"},
          "alt": {"type": "string", "minLength": 1},
          "contains_text": {"type": "boolean"},
          "text_reason": {"type": "string", "minLength": 1},
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"enum": ["authored", "generated", "third_party"]},
              "author": {"type": "string"},
              "tool": {"type": "string"},
              "prompt_file": {"type": "string", "pattern": "^assets/[a-zA-Z0-9_./-]+$"},
              "asset_id": {"type": "string"},
              "source_file": {"type": "string", "pattern": "^assets/[a-zA-Z0-9_./-]+$"},
              "conversion": {"type": "string"},
              "source_url": {"type": "string", "pattern": "^https://"}
            }
          },
          "license": {"type": "string", "minLength": 1},
          "attribution": {"type": "string"},
          "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
