{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/presentation-skill-lab/outline-adapter.schema.json",
  "title": "adapter が出力する outline.json の部分集合 v0.1（上流 presentation-skill v0.14.0 向け）",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "deck_style", "document_metadata", "psl", "slides"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "deck_style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer_role_systems_v1", "footer_source_label"],
      "properties": {
        "renderer_role_systems_v1": {"type": "object"},
        "footer_source_label": {"type": "string"},
        "readability_contract": {"type": "object"}
      }
    },
    "document_metadata": {"type": "object"},
    "psl": {
      "type": "object",
      "required": ["adapter_version", "schema_version", "deck_id", "content_sha256", "synthetic", "classification", "metadata", "theme", "render"],
      "properties": {
        "render": {
          "type": "object",
          "required": ["style_preset"],
          "properties": {"style_preset": {"type": "string"}}
        },
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "variant", "title", "psl"],
        "properties": {
          "type": {"enum": ["title", "section", "content"]},
          "variant": {"enum": ["title", "section", "standard", "table", "chart"]},
          "title": {"type": "string", "minLength": 1},
          "subtitle": {"type": "string"},
          "bullets": {"type": "array", "items": {"type": "string"}},
          "footer": {"type": "string"},
          "caption": {"type": "string"},
          "kicker": {"type": "string"},
          "title_layout": {"type": "string"},
          "notes": {"type": "string"},
          "sources": {"type": "array", "items": {"type": "string"}},
          "table": {
            "type": "object",
            "additionalProperties": false,
            "required": ["headers", "rows"],
            "properties": {
              "headers": {"type": "array", "items": {"type": "string"}},
              "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
              "caption": {"type": "string"},
          "kicker": {"type": "string"},
          "title_layout": {"type": "string"},
              "footnotes": {"type": "array", "items": {"type": "string"}}
            }
          },
          "chart": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "categories", "series"],
            "properties": {
              "type": {"enum": ["bar", "line", "pie"]},
              "categories": {"type": "array", "items": {"type": "string"}},
              "series": {"type": "array", "items": {"type": "object"}}
            }
          },
          "psl": {
            "type": "object",
            "required": ["slide_id", "content_type", "layout"]
          }
        }
      }
    }
  }
}
